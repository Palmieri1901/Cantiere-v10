FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends build-essential libjpeg62-turbo zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt
# Esclude i pacchetti legati all'ambiente Emergent (non necessari in produzione autonoma)
RUN grep -v -i -E "emergent|litellm" /tmp/requirements.txt > /tmp/req-native.txt \
    && pip install --no-cache-dir -r /tmp/req-native.txt

COPY backend/ /app/
ARG APP_COMMIT=
ENV APP_COMMIT=$APP_COMMIT

EXPOSE 8001
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
