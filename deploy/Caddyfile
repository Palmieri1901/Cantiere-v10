# ===== Gestionale (solo amministratore) =====
{$DOMAIN} {
	encode gzip zstd

	# L'app dipendenti vive su un host separato: qui viene solo reindirizzata
	redir /app-dipendente* https://{$APP_DOMAIN}{uri} permanent

	handle /api/* {
		reverse_proxy backend:8001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header /sw.js Cache-Control "no-cache"
	header /manifest.json Cache-Control "no-cache"
	# index.html e pagine: mai in cache, così ogni aggiornamento è visibile subito
	@pagine not path /static/* /api/*
	header @pagine Cache-Control "no-cache, must-revalidate"
}

# ===== App dipendenti (host dedicato, nessun accesso al gestionale) =====
{$APP_DOMAIN} {
	encode gzip zstd

	# Solo le API mobile sono raggiungibili da questo host
	handle /api/mobile/* {
		reverse_proxy backend:8001
	}
	handle /api/* {
		respond "Non disponibile" 403
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header /sw.js Cache-Control "no-cache"
	header /manifest.json Cache-Control "no-cache"
	# index.html e pagine: mai in cache, così ogni aggiornamento è visibile subito
	@pagine not path /static/* /api/*
	header @pagine Cache-Control "no-cache, must-revalidate"
}
